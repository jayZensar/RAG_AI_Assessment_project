# Copy this file to ".env" and fill in ONE of the keys below if you want a hosted LLM.
# No key is required at all - the notebook automatically falls back to a free local
# HuggingFace model (google/flan-t5-base) when none of these are set.
#
# Priority order used by get_llm() in the notebook: GROQ -> OPENAI -> GOOGLE -> local fallback.

GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
